{
  "name": "dsh-ptc-cordis-preset",
  "version": "0.25.0",
  "description": "PTC 创造模式预设:PTC 全部能力 + 创造模式的 Cordis 工具集与编写技能,以声明式注册进入模式名录;run_code 后端可在官方 Node/TypeScript 与实验性 CPython 之间切换。仅支持 dsh >=0.2.2-rc.1。· A Creation-mode preset on top of PTC: the Cordis toolset and authoring skills, declared straight onto the preset roster; run_code can switch between the official Node/TypeScript backend and the experimental CPython backend. Requires dsh >=0.2.2-rc.1.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KannaKuron/dsh-ptc-cordis-preset.git"
  },
  "main": "src/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./runtime": "./src/runtime.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src",
    "assets/*.yml",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/smoke.mjs",
    "version": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('dsh.plugin.json','utf8'));const v=JSON.parse(fs.readFileSync('package.json','utf8')).version;m.version=v;fs.writeFileSync('dsh.plugin.json',JSON.stringify(m,null,2)+'\\n')\" && git add dsh.plugin.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-preset",
    "ptc",
    "code-mode",
    "cordis",
    "dsh-plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-experimental-ptc-runtime-python": "*"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/KannaKuron/dsh-ptc-cordis-preset",
  "bugs": {
    "url": "https://github.com/KannaKuron/dsh-ptc-cordis-preset/issues"
  }
}
